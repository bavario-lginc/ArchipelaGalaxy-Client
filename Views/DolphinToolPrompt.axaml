<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArchipelaGalaxy.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ArchipelaGalaxy.Views.DolphinToolPrompt"
        Width="550"
        Height="400"
        Icon="/Assets/Icon.ico"
        Title="ArchipelaGalaxy: Select or Download DolphinTool"
        CanResize="False">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <StackPanel>
            <TextBlock 
                Text="DolphinTool was not found!"
                FontSize="25.0"
                TextAlignment="Center"
                Margin="0 20 0 0" />
            <TextBlock
                FontSize="17.0"
                Margin="20 20 0 0"
                Text="ArchipelaGalaxy requires DolphinTool to extract your game," />
            <TextBlock
                FontSize="17.0"
                Margin="20 0 0 0"
                Text="but was not able to find it." />
            <TextBlock
                FontSize="17.0"
                Margin="20 10 0 0"
                Text="Please choose one of these two options to get it:" />
            <TextBlock
                FontSize="22.0"
                Margin="20 20 0 0"
                FontStyle="Italic"
                Text="1. Select existing executable:" />
            <Button
                Margin="20 10 0 0"
                Padding="10"
                FontSize="17.0"
                HorizontalAlignment="Left"
                Click="Select">
                Select...
            </Button>
            <TextBlock
                FontSize="22.0"
                Margin="20 20 0 0"
                FontStyle="Italic"
                Text="2. Download executable:" />
            <Button
                Margin="20 10 0 0"
                Padding="10"
                FontSize="17.0"
                HorizontalAlignment="Left"
                Click="Download">
                Download...
            </Button>
        </StackPanel>
    </Panel>
</Window>
